# Jotty URL reachable from the notifier container (its service name on the shared jotty-net network).
JOTTY_URL=http://jotty:3000
# Public Jotty URL for "Open board" links. Leave empty to send messages without links.
APP_URL=https://jotty.example.com
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Seconds between polls.
POLL_INTERVAL=60
# Read-only mount of Jotty's data directory; needed for comment notifications.
JOTTY_DATA_DIR=/jotty-data
# Optional
# Days to remember a board that disappeared (archived, unshared) so its return is not reported as new.
#BOARD_RETENTION_DAYS=30
#REQUEST_TIMEOUT=15
#LOG_LEVEL=INFO
#USERS_FILE=/app/users.yaml
#STATE_DIR=/app/state
